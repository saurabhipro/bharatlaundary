<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Define the homepage template -->
    <template id="homepage" name="Bharat Laundary Home">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                
                <!-- Hero Section: Dynamic, Blue Gradient -->
                <section class="s_cover parallax s_parallax_is_fixed bg-black-50 pt96 pb96 o_colored_level" data-scroll-background-ratio="1" data-snippet="s_cover" data-name="Cover" style="background-image: linear-gradient(135deg, rgba(13, 110, 253, 0.8) 0%, rgba(13, 202, 240, 0.8) 100%), url('/website_bharatlaundary/static/src/img/hero-bg.jpg'); background-position: 50% 50%; padding-top: 15rem; padding-bottom: 15rem;">
                    <div class="container s_allow_columns">
                        <div class="row s_nb_column_fixed">
                            <div class="col-lg-12 text-center text-white">
                                <h1 class="display-3 font-weight-bold mb-4" style="font-size: 4rem;">Bharat Laundary</h1>
                                <p class="lead mb-5" style="font-size: 1.5rem;">Fresh Clothes, Happy Life. India's Most Trusted Laundry Service.</p>
                                <div class="btn-group btn-group-lg" role="group">
                                    <a href="/shop" class="btn btn-primary btn-lg rounded-pill px-5 mx-2 font-weight-bold shadow-lg">Book Pickup Now</a>
                                    <a href="/contactus" class="btn btn-outline-light btn-lg rounded-pill px-5 mx-2 font-weight-bold">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Services Section: 3-Column Grid -->
                <section class="s_features_grid pt48 pb48 bg-100" data-snippet="s_features_grid" data-name="Features Grid">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12 text-center mb-5">
                                <h2 class="display-4 font-weight-bold text-primary">Our Premium Services</h2>
                                <p class="text-muted lead">Professional care for your garments</p>
                            </div>
                        </div>
                        <div class="row">
                            <!-- Service 1 -->
                            <div class="col-lg-4 s_col_no_bgcolor pb24">
                                <div class="card h-100 border-0 shadow-sm service-card text-center p-4">
                                    <div class="card-body">
                                        <i class="fa fa-tint fa-5x text-info mb-4"></i>
                                        <h3 class="card-title font-weight-bold">Wash &amp; Fold</h3>
                                        <p class="card-text text-muted">Premium detergent wash, neatly folded packaging. Perfect for daily wear.</p>
                                        <a href="/shop" class="btn btn-outline-primary mt-3">Order Now</a>
                                    </div>
                                </div>
                            </div>
                            <!-- Service 2 -->
                            <div class="col-lg-4 s_col_no_bgcolor pb24">
                                <div class="card h-100 border-0 shadow-sm service-card text-center p-4">
                                    <div class="card-body">
                                        <i class="fa fa-star fa-5x text-warning mb-4"></i>
                                        <h3 class="card-title font-weight-bold">Dry Cleaning</h3>
                                        <p class="card-text text-muted">Specialized chemical cleaning for suits, silk, and delicate fabrics.</p>
                                        <a href="/shop" class="btn btn-outline-primary mt-3">Order Now</a>
                                    </div>
                                </div>
                            </div>
                            <!-- Service 3 -->
                            <div class="col-lg-4 s_col_no_bgcolor pb24">
                                <div class="card h-100 border-0 shadow-sm service-card text-center p-4">
                                    <div class="card-body">
                                        <i class="fa fa-superpowers fa-5x text-success mb-4"></i>
                                        <h3 class="card-title font-weight-bold">Steam Ironing</h3>
                                        <p class="card-text text-muted">Crisp, wrinkle-free finish that gives your clothes a fresh new look.</p>
                                        <a href="/shop" class="btn btn-outline-primary mt-3">Order Now</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- How It Works Section: Steps -->
                <section class="s_process_steps pt48 pb48 bg-white" data-snippet="s_process_steps" data-name="Process Steps">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12 text-center mb-5">
                                <h2 class="font-weight-bold">How It Works</h2>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4 text-center mb-4">
                                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">1</div>
                                <h4>Book Pickup</h4>
                                <p class="text-muted">Schedule a pickup online via our Shop or call us.</p>
                            </div>
                            <div class="col-lg-4 text-center mb-4">
                                <div class="rounded-circle bg-info text-white d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">2</div>
                                <h4>We Wash</h4>
                                <p class="text-muted">Expert cleaning using premium eco-friendly products.</p>
                            </div>
                            <div class="col-lg-4 text-center mb-4">
                                <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">3</div>
                                <h4>Fast Delivery</h4>
                                <p class="text-muted">Get your fresh, clean clothes delivered to your doorstep.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Call to Action Footer -->
                <section class="s_call_to_action pt48 pb48 bg-200" data-snippet="s_call_to_action" data-name="Call to Action">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-9 pb24">
                                <h3 class="font-weight-bold">Ready to experience premium laundry?</h3>
                                <p class="lead mb-0">Join thousands of happy customers today.</p>
                            </div>
                            <div class="col-lg-3 pb24 text-right">
                                <a href="/shop" class="btn btn-primary btn-lg rounded-pill shadow px-5">Get Started</a>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <template id="rate_list_page" name="Bharat Laundary Rate List">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Header Section -->
                <section class="s_title pt96 pb96" style="background-color: #3498db;">
                    <div class="container text-center text-white">
                        <div class="mb-4">
                            <span class="fa-stack fa-4x">
                                <i class="fa fa-circle fa-stack-2x text-white"></i>
                                <i class="fa fa-shirtsinbulk fa-stack-1x text-primary"></i>
                            </span>
                        </div>
                        <h1 class="display-2 font-weight-bold text-uppercase mb-2" style="letter-spacing: 2px;">Pick My Laundry</h1>
                        
                        <div class="d-inline-block bg-white text-primary px-5 py-2 mt-4 mb-4 position-relative" style="transform: skew(-10deg);">
                            <h2 class="font-weight-bold m-0 text-uppercase" style="transform: skew(10deg);">Price List</h2>
                        </div>
                        
                        <p class="h3 font-weight-light text-uppercase mt-2">Dry-Cleaning &amp; Home Service</p>
                        <div class="mt-4">
                            <a href="tel:9971522720" class="btn btn-lg btn-outline-light rounded-pill px-5 font-weight-bold">
                                <i class="fa fa-phone mr-2"></i> Call Now
                            </a>
                        </div>
                    </div>
                </section>
                
                <!-- Rate List Content -->
                <section class="bg-white pt64 pb64">
                    <div class="container">
                        <div class="row">
                            <!-- Use CSS columns for masonry layout -->
                            <div class="col-12" style="column-count: 2; column-gap: 60px;">
                                <style>
                                    @media (max-width: 768px) {
                                        .col-12 { column-count: 1 !important; }
                                    }
                                </style>
                                
                                <t t-foreach="categories" t-as="category">
                                    <div class="mb-5" style="break-inside: avoid-column; page-break-inside: avoid;">
                                        <!-- Category Header -->
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="bg-primary text-white px-3 py-1 rounded shadow-sm">
                                                <h4 class="m-0 font-weight-bold text-uppercase"><t t-esc="category.name"/></h4>
                                            </div>
                                            <t t-if="category.name in ['Men', 'Women', 'Household']">
                                                <span class="ml-2 text-info font-weight-bold small text-uppercase">Dry Cleaning</span>
                                            </t>
                                        </div>
                                        
                                        <!-- Products List -->
                                        <t t-if="category.product_tmpl_ids">
                                            <table class="table table-borderless table-sm mb-0">
                                                <tbody>
                                                    <tr t-foreach="category.product_tmpl_ids" t-as="product">
                                                        <td class="pl-0 py-1">
                                                            <div class="d-flex align-items-center">
                                                                <!-- Placeholder icon/image if needed -->
                                                                <span class="text-primary font-weight-bold" style="font-size: 1.1rem;">
                                                                    <t t-esc="product.name"/>
                                                                </span>
                                                                <t t-if="product.name == 'Lehenga Bridal'">
                                                                    <span class="badge badge-info ml-2" style="font-size: 0.6rem;">Starting Price</span>
                                                                </t>
                                                            </div>
                                                        </td>
                                                        <td class="text-right py-1">
                                                            <span class="text-info font-weight-bold" style="font-size: 1.1rem;">
                                                                <t t-esc="int(product.list_price)"/>/-
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted font-italic pl-2">No items listed.</p>
                                        </t>
                                        
                                        <!-- Add decorative separator if desired -->
                                        <div class="border-bottom mt-3 w-25"></div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- Footer Banner -->
                <section class="py-5 text-white text-center" style="background-color: #f1c40f;">
                    <div class="container">
                        <div class="row align-items-center justify-content-center">
                            <div class="col-md-8">
                                <h3 class="font-weight-bold text-primary mb-0">Now Available on App Store &amp; Play Store</h3>
                            </div>
                            <div class="col-md-4 mt-3 mt-md-0">
                                <div class="d-flex justify-content-center gap-3">
                                    <button class="btn btn-dark btn-lg mr-2"><i class="fa fa-apple"></i> App Store</button>
                                    <button class="btn btn-dark btn-lg"><i class="fa fa-android"></i> Play Store</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- Menu Item for Rate List -->
    <record id="menu_bharatlaundary_rate_list" model="website.menu">
        <field name="name">Rate List</field>
        <field name="url">/rate-list</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">20</field>
    </record>

</odoo>
