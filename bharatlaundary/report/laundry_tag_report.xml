<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format for Laundry Tag -->
    <record id="paperformat_laundry_tag" model="report.paperformat">
        <field name="name">Laundry Tag (Small)</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">55</field>
        <field name="page_width">40</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_laundry_tag" model="ir.actions.report">
        <field name="name">Print Laundry Tags</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bharatlaundary.report_laundry_tag_template</field>
        <field name="report_file">bharatlaundary.report_laundry_tag_template</field>
        <field name="print_report_name">'Laundry Tags - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_laundry_tag"/>
    </record>

    <!-- Report Template -->
    <template id="report_laundry_tag_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-foreach="doc._get_laundry_tags()" t-as="tag">
                    <div class="page" t-att-style="'width: 38mm; height: 53mm; padding: 1mm 0; margin: 0 auto; box-sizing: border-box; font-family: sans-serif; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2mm; overflow: hidden; background: white;' + ('page-break-after: always;' if not tag_last else '')">
                        
                        <!-- Header: Date & Brand -->
                        <div style="line-height: 2;">
                            <div style="font-size: 5pt; font-weight: bold;"><t t-esc="tag['date']"/></div>
                            <div style="font-size: 6pt; font-weight: 900; text-transform: uppercase;">Bharat Laundary</div>
                        </div>  

                        <!-- Order Info -->
                        <div style="line-height: 2;">
                            <div style="font-size: 14pt; font-weight: 900;"><t t-esc="tag['order_name']"/></div>
                            <div style="font-size: 7pt; font-weight: bold; margin-top: 1px; max-width: 36mm; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><t t-esc="tag['customer_name']"/></div>
                        </div>

                        <!-- Service Code Box -->
                        <div style="width: 85%; background-color: #f2f2f2; padding: 0.5mm 0; border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                            <div style="font-size: 18pt; font-weight: 900; line-height: 1; color: #000;"><t t-esc="tag['service_code']"/></div>
                        </div>

                        <!-- Product Name -->
                        <div style="font-size: 9pt; font-weight: bold; line-height: 2; padding: 0 1mm;">
                            <t t-esc="tag['product_name']"/>
                        </div>

                        <!-- Footer: Counter & URL -->
                        <div style="width: 100%; line-height: 2;">
                             <div style="font-size: 12pt; font-weight: 900; margin-bottom: 0.5px;"><t t-esc="tag['counter_str']"/></div>
                             <div style="font-size: 4pt; color: #666; text-transform: lowercase;">bharatlaundary.com</div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
