<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format for Laundry Tag -->
    <record id="paperformat_laundry_tag" model="report.paperformat">
        <field name="name">Laundry Tag (Small)</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">80</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_laundry_tag" model="ir.actions.report">
        <field name="name">Print Laundry Tags</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bharatlaundary.report_laundry_tag_template</field>
        <field name="report_file">bharatlaundary.report_laundry_tag_template</field>
        <field name="print_report_name">'Laundry Tags - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_laundry_tag"/>
    </record>

    <!-- Report Template -->
    <template id="report_laundry_tag_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-foreach="doc._get_laundry_tags()" t-as="tag">
                    <div class="page" t-att-style="'width: 80mm; height: 80mm; padding: 5mm; font-family: sans-serif; text-align: center; border: 1px dashed #ccc; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; overflow: hidden;' + ('page-break-after: always;' if not tag_last else '')">
                        
                        <!-- Top Header: Date & Brand -->
                        <div style="font-size: 8pt; font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 3px; margin-bottom: 5px; width: 100%; display: flex; justify-content: space-between;">
                            <span><t t-esc="tag['date'].split(',')[0]"/></span>
                            <span>BHARAT LAUNDRY</span>
                        </div>

                        <!-- SO Number (Very Large) -->
                        <div style="font-size: 22pt; font-weight: 900; margin-bottom: 2px; line-height: 1;">
                            <t t-esc="tag['order_name']"/>
                        </div>
                        
                        <!-- Customer Name (Truncated if long) -->
                        <div style="font-size: 10pt; font-weight: bold; margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;">
                            <t t-esc="tag['customer_name']"/>
                        </div>

                        <!-- Product Name -->
                        <div style="font-size: 14pt; font-weight: bold; margin-bottom: 5px; line-height: 1.2;">
                            <t t-esc="tag['product_name']"/>
                        </div>

                        <!-- Counter & Service Code Row -->
                        <div style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 5px;">
                            <!-- Counter Circle -->
                            <div style="font-size: 16pt; font-weight: bold;">
                                <t t-esc="tag['index']"/>/<t t-esc="tag['total']"/>
                            </div>
                            
                            <!-- Service Code Box -->
                            <div style="border: 3px solid #000; padding: 2px 6px; font-size: 18pt; font-weight: 900;">
                                <t t-esc="tag['service_code']"/>
                            </div>
                        </div>

                        <!-- Bottom Branding -->
                        <div style="position: absolute; bottom: 2px; width: 100%; text-align: center; font-size: 7pt; color: #555;">
                            bharatlaundry.com
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
