<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format for Laundry Tag -->
    <record id="paperformat_laundry_tag" model="report.paperformat">
        <field name="name">Laundry Tag (Small)</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">80</field>
        <field name="page_width">40</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_laundry_tag" model="ir.actions.report">
        <field name="name">Print Laundry Tags</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bharatlaundary.report_laundry_tag_template</field>
        <field name="report_file">bharatlaundary.report_laundry_tag_template</field>
        <field name="print_report_name">'Laundry Tags - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_laundry_tag"/>
    </record>

    <!-- Report Template -->
    <template id="report_laundry_tag_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-foreach="doc._get_laundry_tags()" t-as="tag">
                    <div class="page" t-att-style="'width: 38mm; height: 78mm; padding: 0; margin: 0; box-sizing: border-box; font-family: sans-serif; text-align: center; display: flex; flex-direction: column; position: relative; overflow: hidden; background: white;' + ('page-break-after: always;' if not tag_last else '')">
                        
                        <!-- Header Row: Date & Brand (Stacked & Centered) -->
                        <div style="height: 12%; display: flex; flex-direction: column; justify-content: center; align-items: center; line-height: 1.2;">
                            <div style="font-weight: bold; font-size: 6pt;"><t t-esc="tag['date']"/></div>
                            <div style="font-weight: bold; font-size: 6pt;">BHARAT LAUNDARY</div>
                        </div>

                        <!-- Order & Customer -->
                        <div style="height: 20%; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                            <div style="font-size: 15pt; font-weight: 900; line-height: 1;"><t t-esc="tag['order_name']"/></div>
                            <div style="font-size: 6pt; font-weight: bold; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 95%; margin-top: 2px;"><t t-esc="tag['customer_name']"/></div>
                        </div>

                        <!-- Main Code (DC/PL) -->
                        <div style="height: 28%; display: flex; align-items: center; justify-content: center; background-color: #f0f0f0;">
                            <div style="font-size: 24pt; font-weight: 900; line-height: 1;"><t t-esc="tag['service_code']"/></div>
                        </div>

                        <!-- Product Name -->
                        <div style="height: 20%; display: flex; align-items: center; justify-content: center; padding: 0 5px;">
                            <div style="font-size: 10pt; font-weight: bold; line-height: 1.1; text-align: center;"><t t-esc="tag['product_name']"/></div>
                        </div>

                        <!-- Footer: Counter -->
                        <div style="height: 20%; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative;">
                             <div style="font-size: 14pt; font-weight: 900;"><t t-esc="tag['counter_str']"/></div>
                             <div style="position: absolute; bottom: 2px; font-size: 4pt; color: #666;">bharatlaundary.com</div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
