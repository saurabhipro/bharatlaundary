<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Parent Category -->
        <record id="product_category_bharatlaundary" model="product.public.category">
            <field name="name">Bharat Laundary</field>
            <field name="sequence">10</field>
        </record>

        <!-- Sub Categories as per Excel -->
        <record id="product_category_laundry" model="product.public.category">
            <field name="name">Laundry</field>
            <field name="parent_id" ref="product_category_bharatlaundary"/>
            <field name="sequence">1</field>
        </record>

        <record id="product_category_premium_laundry" model="product.public.category">
            <field name="name">Premium Laundry</field>
            <field name="parent_id" ref="product_category_bharatlaundary"/>
            <field name="sequence">2</field>
        </record>

        <record id="product_category_addons" model="product.public.category">
            <field name="name">Add Ons</field>
            <field name="parent_id" ref="product_category_bharatlaundary"/>
            <field name="sequence">3</field>
        </record>

        <record id="product_category_men_dry_cleaning" model="product.public.category">
            <field name="name">Men Dry Cleaning</field>
            <field name="parent_id" ref="product_category_bharatlaundary"/>
            <field name="sequence">4</field>
        </record>

        <record id="product_category_women_dry_cleaning" model="product.public.category">
            <field name="name">Women Dry Cleaning</field>
            <field name="parent_id" ref="product_category_bharatlaundary"/>
            <field name="sequence">5</field>
        </record>

        <!-- Service Types as Attributes (for categorization and variants on website) -->
        <record id="product_attribute_service_type" model="product.attribute">
            <field name="name">Service Type</field>
            <field name="create_variant">no_variant</field>
            <field name="display_type">radio</field>
        </record>
        
        <record id="product_attribute_value_wash_fold" model="product.attribute.value">
            <field name="name">Wash &amp; Fold</field>
            <field name="attribute_id" ref="product_attribute_service_type"/>
            <field name="sequence">1</field>
        </record>
        
        <record id="product_attribute_value_wash_iron" model="product.attribute.value">
            <field name="name">Wash &amp; Iron</field>
            <field name="attribute_id" ref="product_attribute_service_type"/>
            <field name="sequence">2</field>
        </record>

        <record id="product_attribute_value_premium_laundry" model="product.attribute.value">
            <field name="name">Premium Laundry</field>
            <field name="attribute_id" ref="product_attribute_service_type"/>
            <field name="sequence">3</field>
        </record>

        <record id="product_attribute_value_dry_cleaning" model="product.attribute.value">
            <field name="name">Dry Cleaning</field>
            <field name="attribute_id" ref="product_attribute_service_type"/>
            <field name="sequence">4</field>
        </record>

    </data>
</odoo>
