<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define Views -->
    <record id="view_bharatlaundary_service_list" model="ir.ui.view">
        <field name="name">bharatlaundary.service.list</field>
        <field name="model">bharatlaundary.service</field>
        <field name="arch" type="xml">
            <list string="Bharat Laundary Services">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bharatlaundary_service_form" model="ir.ui.view">
        <field name="name">bharatlaundary.service.form</field>
        <field name="model">bharatlaundary.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Define Actions -->
    <record id="action_bharatlaundary_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">bharatlaundary.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first service!
            </p>
        </field>
    </record>

    <!-- Define Menus -->
    <menuitem id="menu_bharatlaundary_root" name="Bharat Laundary" sequence="10"/>
    <menuitem id="menu_bharatlaundary_service" name="Services" parent="menu_bharatlaundary_root" action="action_bharatlaundary_service" sequence="10"/>
</odoo>
