<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_laundry" model="ir.ui.view">
        <field name="name">account.move.form.laundry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="service_tag_ids" widget="many2many_tags" optional="show" string="Tags" options="{'color_field': 'color'}"/>
            </xpath>
        </field>
    </record>
</odoo>
