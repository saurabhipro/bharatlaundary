<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_laundry" model="ir.ui.view">
        <field name="name">sale.order.form.laundry</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Laundry Status above the standard SO status -->
            <xpath expr="//header" position="inside">
                <button name="action_print_laundry_tags" string="Print Tags" type="object" class="oe_highlight" icon="fa-print"/>
                <field name="laundry_state" widget="statusbar" options="{'clickable': '1'}"/>
            </xpath>
            
            <!-- Add Rider field in the form -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="rider_id" placeholder="Select Rider..."/>
            </xpath>

            <!-- Add Piece Count and UOM to Order Lines -->
            <!-- Add Piece Count and UOM to Order Lines -->
            <!-- Using 'list' tag instead of 'tree' for Odoo 18 compatibility -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="piece_count" string="Pieces" sum="Total Pieces"/>
                <field name="service_tag_ids" widget="many2many_tags" optional="show" options="{'color_field': 'color'}"/>
            </xpath>
            
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="attributes">
                 <attribute name="string">Weight/Qty</attribute>
            </xpath>
        </field>
    </record>

    <!-- Support for laundry status in Sale Order List view -->
    <record id="view_quotation_tree_inherit_laundry" model="ir.ui.view">
        <field name="name">sale.order.list.laundry</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_mobile" string="Mobile/Phone" optional="show"/>
                <field name="rider_id" optional="show"/>
            </xpath>
            <field name="state" position="after">
                <field name="laundry_state" widget="badge" 
                    decoration-info="laundry_state == 'picked'"
                    decoration-warning="laundry_state == 'processing'"
                    decoration-success="laundry_state in ('ready', 'delivered', 'invoiced')"/>
            </field>
        </field>
    </record>

    <record id="view_order_tree_inherit_laundry" model="ir.ui.view">
        <field name="name">sale.order.order.list.laundry</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_mobile" string="Mobile/Phone" optional="show"/>
                <field name="rider_id" optional="show"/>
            </xpath>
            <field name="state" position="after">
                <field name="laundry_state" widget="badge" 
                    decoration-info="laundry_state == 'picked'"
                    decoration-warning="laundry_state == 'processing'"
                    decoration-success="laundry_state in ('ready', 'delivered', 'invoiced')"/>
            </field>
        </field>
    </record>
    <!-- Bulk action to Confirm Quotations -->
    <record id="action_confirm_quotations_bulk" model="ir.actions.server">
        <field name="name">Confirm Quotations</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.filtered(lambda r: r.state in ('draft', 'sent')).action_confirm()
        </field>
    </record>
</odoo>
