<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bharatlaundary</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Remove About Section -->
            <xpath expr="//div[@id='about']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add OTP Settings above About Section -->
            <xpath expr="//div[@id='about']" position="before">
                <block title="OTP API Settings" name="otp_api_settings">
                    <setting string="Configuration" help="Configure API settings for sending SMS messages.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label string="API URL" for="otp_api_url" class="col-lg-3 o_light_label"/>
                                <field name="otp_api_url" class="oe_inline"/>
                            </div>
                            <div class="row">
                                <label string="API Key" for="otp_api_key" class="col-lg-3 o_light_label"/>
                                <field name="otp_api_key" password="True" class="oe_inline"/>
                            </div>
                            <div class="row">
                                <label string="Client ID" for="otp_client_id" class="col-lg-3 o_light_label"/>
                                <field name="otp_client_id" class="oe_inline"/>
                            </div>
                            <div class="row">
                                <label string="Sender ID" for="otp_sender_id" class="col-lg-3 o_light_label"/>
                                <field name="otp_sender_id" class="oe_inline"/>
                            </div>
                            <div class="row">
                                <label string="DLT Template ID" for="dlt_template_id" class="col-lg-3 o_light_label"/>
                                <field name="dlt_template_id" class="oe_inline"/>
                            </div>
                            <div class="row">
                                <label string="Message Template" for="otp_message_template" class="col-lg-3 o_light_label"/>
                                <field name="otp_message_template" class="oe_inline"/>
                            </div>
                            <div class="row">
                                <label string="Android App Hash" for="android_app_hash" class="col-lg-3 o_light_label"/>
                                <field name="android_app_hash" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Test SMS" help="Enter a mobile number and click the button to test if the SMS is sent successfully.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label string="Mobile Number" for="test_mobile_number" class="col-lg-3 o_light_label"/>
                                <field name="test_mobile_number" class="oe_inline"/>
                            </div>
                            <div class="mt16">
                                <button name="action_test_sms_otp" icon="oi-arrow-right" type="object" string="Test SMS" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
