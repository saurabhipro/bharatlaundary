<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bharatlaundary</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="OTP API Settings" name="otp_api_settings">
                    <setting string="OTP API Configuration" help="Configure OTP API settings for sending SMS messages.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="otp_api_url" class="col-lg-3 o_light_label"/>
                                <field name="otp_api_url"/>
                            </div>
                            <div class="row">
                                <label for="otp_api_key" class="col-lg-3 o_light_label"/>
                                <field name="otp_api_key"/>
                            </div>
                            <div class="row">
                                <label for="otp_client_id" class="col-lg-3 o_light_label"/>
                                <field name="otp_client_id"/>
                            </div>
                            <div class="row">
                                <label for="otp_sender_id" class="col-lg-3 o_light_label"/>
                                <field name="otp_sender_id"/>
                            </div>
                            <div class="row">
                                <label for="dlt_template_id" class="col-lg-3 o_light_label"/>
                                <field name="dlt_template_id"/>
                            </div>
                            <div class="row">
                                <label for="otp_message_template" class="col-lg-3 o_light_label"/>
                                <field name="otp_message_template"/>
                            </div>
                            <div class="row">
                                <label for="android_app_hash" class="col-lg-3 o_light_label"/>
                                <field name="android_app_hash"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Test SMS Configuration" help="Enter a mobile number and click the button to test if the OTP SMS is sent successfully.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="test_mobile_number" class="col-lg-3 o_light_label"/>
                                <field name="test_mobile_number"/>
                            </div>
                            <div class="mt16">
                                <button name="action_test_sms_otp" icon="oi-arrow-right" type="object" string="Test SMS" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
