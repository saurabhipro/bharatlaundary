                                <ul class="list-unstyled mb-4">
                                    <li class="mb-2"><i class="fa fa-check text-success mr-2"></i> Stubborn stain removal</li>
                                    <li class="mb-2"><i class="fa fa-check text-success mr-2"></i> Wrinkle-free finish</li>
                                    <li class="mb-2"><i class="fa fa-check text-success mr-2"></i> Hanger delivery available</li>
                                </ul>
                                <a href="/pricing" class="btn btn-outline-primary rounded-pill px-4">See Pricing</a>
                            </div>
                        </div>

                        <!-- Service 3: Dry Cleaning -->
                        <div class="row align-items-center mb-5 bg-white rounded shadow-sm overflow-hidden">
                            <div class="col-md-6 p-0 h-100">
                                <div class="bg-light w-100 h-100 d-flex align-items-center justify-content-center" style="min-height: 300px;">
                                    <i class="fa fa-black-tie fa-5x text-muted opacity-25"></i>
                                </div>
                            </div>
                            <div class="col-md-6 p-5">
                                <div class="icon-box text-primary mb-3">
                                    <i class="fa fa-black-tie fa-3x"></i>
                                </div>
                                <h3 class="font-weight-bold mb-3">Premium Dry Cleaning</h3>
                                <p class="text-muted mb-4">Default care for your most expensive garments. Suits, silk sarees, lehengas, and woolens are treated with distinct eco-friendly solvents.</p>
                                <ul class="list-unstyled mb-4">
                                    <li class="mb-2"><i class="fa fa-check text-success mr-2"></i> Fabric-specific treatment</li>
                                    <li class="mb-2"><i class="fa fa-check text-success mr-2"></i> Example: Petrol wash for distinct stains</li>
                                    <li class="mb-2"><i class="fa fa-check text-success mr-2"></i> Free minor repairs</li>
                                </ul>
                                <a href="/pricing" class="btn btn-outline-primary rounded-pill px-4">See Pricing</a>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- CTA Section -->
                <section class="py-5 bg-white text-center">
                    <div class="container">
                        <h2 class="mb-4">Ready to schedule a pickup?</h2>
                         <a href="https://wa.me/917988543386" class="btn btn-success btn-lg rounded-pill px-5 shadow-lg">
                            <i class="fa fa-whatsapp mr-2"></i> Book via WhatsApp
                        </a>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- Menu Item for Rate List -->
    <record id="menu_bharatlaundary_rate_list" model="website.menu">
        <field name="name">Pricing</field>
        <field name="url">/pricing</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">20</field>
    </record>

