<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Define the homepage template -->
    <template id="homepage" name="Bharat Laundary Home">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                
                <!-- Hero Section: Dynamic, Blue Gradient -->
                <section class="s_cover parallax s_parallax_is_fixed bg-black-50 pt96 pb96 o_colored_level" data-scroll-background-ratio="1" data-snippet="s_cover" data-name="Cover" style="background-image: linear-gradient(135deg, rgba(13, 110, 253, 0.8) 0%, rgba(13, 202, 240, 0.8) 100%), url('/bharatlaundary/static/src/img/hero-bg.jpg'); background-position: 50% 50%; padding-top: 15rem; padding-bottom: 15rem;">
                    <div class="container s_allow_columns">
                        <div class="row s_nb_column_fixed">
                            <div class="col-lg-12 text-center text-white">
                                <h1 class="display-3 font-weight-bold mb-4" style="font-size: 4rem;">Bharat Laundary</h1>
                                <p class="lead mb-5" style="font-size: 1.5rem;">Fresh Clothes, Happy Life. India's Most Trusted Laundry Service.</p>
                                <div class="btn-group btn-group-lg" role="group">
                                    <a href="/shop" class="btn btn-primary btn-lg rounded-pill px-5 mx-2 font-weight-bold shadow-lg">Book Pickup Now</a>
                                    <a href="/contactus" class="btn btn-outline-light btn-lg rounded-pill px-5 mx-2 font-weight-bold">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Services Section: Combo Choices -->
                <section class="pb64 bg-100" id="services_section" style="padding-top: 80px;">
                    <div class="container text-center">
                        <div class="row mb-5">
                            <div class="col-lg-12">
                                <h2 class="display-4 font-weight-bold text-dark">Our Premium Services</h2>
                                <p class="text-muted lead">Smart choices for every laundry need</p>
                                <div class="h-1 bg-primary w-25 mx-auto mt-4 mb-5" style="height: 4px; border-radius: 2px;"></div>
                            </div>
                        </div>

                        <div class="row g-4 d-flex justify-content-center">
                            <t t-foreach="combos" t-as="combo">
                                <div class="col-lg-3 col-md-6 mb-4">
                                    <div class="card h-100 border-0 shadow-sm combo-card text-center p-4 transition-all" style="border-radius: 20px; background: #fff;">
                                        <div class="card-body d-flex flex-column h-100">
                                            <!-- Icon Circle -->
                                            <div class="rounded-circle bg-success d-inline-flex mb-4 p-4 mx-auto align-items-center justify-content-center shadow-sm" style="width: 100px; height: 100px; background-color: #4CAF50 !important;">
                                                <i t-attf-class="fa #{combo.icon_class} fa-4x text-white"></i>
                                            </div>
                                            
                                            <h3 class="card-title font-weight-bold mb-4" style="color: #333;"><t t-esc="combo.name"/></h3>
                                            
                                            <!-- Feature List -->
                                            <div class="feature-list text-left mb-auto" style="font-size: 0.95rem; color: #666;">
                                                <div t-if="combo.turnaround" class="d-flex align-items-baseline mb-2">
                                                    <i class="fa fa-check text-success mr-2"></i>
                                                    <span t-esc="combo.turnaround"/>
                                                </div>
                                                <div t-if="combo.packaging" class="d-flex align-items-baseline mb-2">
                                                    <i class="fa fa-check text-success mr-2"></i>
                                                    <span t-esc="combo.packaging"/>
                                                </div>
                                                <div t-if="combo.suitability" class="d-flex align-items-baseline mb-2">
                                                    <i class="fa fa-check text-success mr-2"></i>
                                                    <span t-esc="combo.suitability"/>
                                                </div>
                                            </div>

                                            <!-- Divider -->
                                            <div class="border-top my-4" style="border-color: #eee !important;"></div>

                                            <!-- Price -->
                                            <div class="price-box">
                                                <h3 class="font-weight-bold m-0" style="color: #333;">
                                                    ₹<t t-esc="int(combo.price)"/>/<t t-esc="combo.uom"/>+tax
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                    
                    <style>
                        .combo-card:hover { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important; }
                        .transition-all { transition: all 0.3s ease-in-out; }
                        .bg-success { background-color: #4CAF50 !important; }
                        .text-success { color: #4CAF50 !important; }
                    </style>
                </section>

                <!-- How It Works Section: Steps -->
                <section class="s_process_steps pt48 pb48 bg-white" data-snippet="s_process_steps" data-name="Process Steps">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12 text-center mb-5">
                                <h2 class="font-weight-bold">How It Works</h2>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4 text-center mb-4">
                                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">1</div>
                                <h4>Book Pickup</h4>
                                <p class="text-muted">Schedule a pickup online via our Shop or call us.</p>
                            </div>
                            <div class="col-lg-4 text-center mb-4">
                                <div class="rounded-circle bg-info text-white d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">2</div>
                                <h4>We Wash</h4>
                                <p class="text-muted">Expert cleaning using premium eco-friendly products.</p>
                            </div>
                            <div class="col-lg-4 text-center mb-4">
                                <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">3</div>
                                <h4>Fast Delivery</h4>
                                <p class="text-muted">Get your fresh, clean clothes delivered to your doorstep.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Call to Action Footer -->
                <section class="s_call_to_action pt48 pb48 bg-200" data-snippet="s_call_to_action" data-name="Call to Action">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-9 pb24">
                                <h3 class="font-weight-bold">Ready to experience premium laundry?</h3>
                                <p class="lead mb-0">Join thousands of happy customers today.</p>
                            </div>
                            <div class="col-lg-3 pb24 text-right">
                                <a href="/shop" class="btn btn-primary btn-lg rounded-pill shadow px-5">Get Started</a>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <template id="rate_list_page" name="Bharat Laundary Rate List">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Premium Hero Section -->
                <section class="s_cover pt120 pb120 text-white" style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.4)), url('/bharatlaundary/static/src/img/pricing_hero.png'); background-size: cover; background-position: center; border-bottom: 5px solid #0d6efd;">
                    <div class="container text-center">
                        <span class="badge badge-pill badge-primary px-3 py-2 mb-3 shadow-sm animate__animated animate__fadeInDown" style="text-transform: uppercase; font-size: 0.8rem; letter-spacing: 2px;">Transparent Pricing</span>
                        <h1 class="display-3 font-weight-bold mb-2">Our Rate List</h1>
                        <p class="lead mb-4 opacity-75">Professional laundry and dry cleaning at your fingertips</p>
                        <div class="d-inline-flex align-items-center bg-primary rounded-pill p-1 shadow-lg">
                            <span class="px-4 py-2 font-weight-bold">Questions? Call us +91 99715 22720</span>
                        </div>
                    </div>
                </section>
                
                <!-- Category Grid -->
                <section class="bg-white pt64 pb96">
                    <div class="container-fluid px-lg-5">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 justify-content-center">
                            <t t-foreach="categories" t-as="category">
                                <div class="col mb-4">
                                    <div class="card border-0 shadow-sm h-100 compact-card transition-all">
                                        <!-- Header -->
                                        <div class="card-header bg-primary text-white py-3 px-4 border-0 d-flex justify-content-between align-items-center" style="border-radius: 12px 12px 0 0;">
                                            <h5 class="m-0 font-weight-bold text-uppercase" style="letter-spacing: 1px;"><t t-esc="category.name"/></h5>
                                            <i class="fa fa-snowflake-o opacity-50"></i>
                                        </div>
                                        
                                        <!-- ListBody -->
                                        <div class="card-body p-0">
                                            <t t-if="category.product_tmpl_ids">
                                                <ul class="list-group list-group-flush">
                                                    <li t-foreach="category.product_tmpl_ids" t-as="product" class="list-group-item d-flex justify-content-between align-items-center py-2 px-4 hover-bg-light border-bottom-soft">
                                                        <div class="flex-grow-1">
                                                            <div class="font-weight-600 text-dark" style="font-size: 0.95rem;"><t t-esc="product.name"/></div>
                                                            <t t-if="product.uom_id">
                                                                <small class="text-primary text-uppercase font-weight-bold" style="font-size: 0.65rem; opacity: 0.8;">
                                                                    PER <t t-esc="product.uom_id.name"/>
                                                                </small>
                                                            </t>
                                                        </div>
                                                        <div class="text-right">
                                                            <span class="font-weight-bold text-primary" style="font-size: 1.1rem;">
                                                                ₹<t t-esc="int(product.list_price)"/>
                                                            </span>
                                                        </div>
                                                    </li>
                                                </ul>
                                            </t>
                                            <t t-else="">
                                                <div class="p-4 text-center text-muted italic small">Category details updating soon...</div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
                
                <!-- Trust Footer -->
                <section class="py-4 bg-light border-top border-bottom">
                    <div class="container">
                        <div class="row text-center">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <i class="fa fa-truck fa-2x text-primary mb-2"></i>
                                <h6 class="font-weight-bold m-0 text-uppercase small">Free Pickup &amp; Drop</h6>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <i class="fa fa-shield fa-2x text-primary mb-2"></i>
                                <h6 class="font-weight-bold m-0 text-uppercase small">Hygienic Process</h6>
                            </div>
                            <div class="col-md-4">
                                <i class="fa fa-clock-o fa-2x text-primary mb-2"></i>
                                <h6 class="font-weight-bold m-0 text-uppercase small">24h Express Available</h6>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- Custom Styles -->
                <style>
                    .pt120 { padding-top: 120px !important; }
                    .pb120 { padding-bottom: 120px !important; }
                    .font-weight-600 { font-weight: 600; }
                    .compact-card { border-radius: 12px !important; overflow: hidden; background: #fff; }
                    .border-bottom-soft { border-bottom: 1px solid rgba(0,0,0,0.03) !important; }
                    .hover-bg-light:hover { background-color: #f8fbff; }
                    .compact-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
                    .transition-all { transition: all 0.2s ease-in-out; }
                    .bg-primary { background-color: #0d6efd !important; }
                    .text-primary { color: #0d6efd !important; }
                    .display-3 { font-size: 3.5rem; letter-spacing: -1px; }
                    @media (max-width: 768px) {
                        .display-3 { font-size: 2.5rem; }
                        .container-fluid { px: 1rem !important; }
                    }
                </style>
            </div>
        </t>
    </template>

    <!-- Menu Item for Rate List -->
    <record id="menu_bharatlaundary_rate_list" model="website.menu">
        <field name="name">Pricing</field>
        <field name="url">/pricing</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">5</field>
    </record>

</odoo>
