            <div id="wrap" class="oe_structure">
                <!-- Services Hero -->
                <section class="py-5 bg-primary text-white text-center" style="background-image: linear-gradient(135deg, #00adef 0%, #007bff 100%);">
                    <div class="container py-5">
                        <h1 class="display-4 font-weight-bold mb-3">Our Premium Services</h1>
                        <p class="lead mb-0 opacity-75">From daily laundry to delicate dry cleaning, we handle it all with care.</p>
                    </div>
                </section>

                <!-- Detailed Services List -->
                <section class="py-5 bg-light">
                    <div class="container">
                        <!-- Service 1: Wash & Fold -->
                        <div class="row align-items-center mb-5 bg-white rounded shadow-sm overflow-hidden">
                            <div class="col-md-6 p-0 h-100">
                                <img src="/bharatlaundary/static/src/img/services-clothes.jpg" class="img-fluid w-100 h-100 object-fit-cover" alt="Wash &amp; Fold" style="min-height: 300px; object-fit: cover;"/>
                            </div>
                            <div class="col-md-6 p-5">
                                <div class="icon-box text-primary mb-3">
                                    <i class="fa fa-tint fa-3x"></i>
                                </div>
                                <h3 class="font-weight-bold mb-3">Wash &amp; Fold</h3>
