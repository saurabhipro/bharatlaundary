<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Define the homepage template, inheriting from website.homepage to override default -->
    <template id="homepage" inherit_id="website.homepage" name="Bharat Laundary Home">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- Hero Section: PickMyLaundry Style (Clean, White, Blue Accents) -->
                <section class="s_cover pt64 pb64 bg-white" data-snippet="s_cover" data-name="Hero" style="min-height: 80vh; display: flex; align-items: center;">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6 order-2 order-lg-1">
                                <h1 class="hero-title mb-3">Premium Laundry &amp; Dry Cleaning Services</h1>
                                <h3 class="font-weight-light mb-4 text-muted">Doorstep pickup &amp; delivery in 48 hours</h3>
                                <p class="lead mb-5" style="color: #555;">
                                    We collect, clean, and deliver your laundry at your doorstep. <br/>
                                    Experience the future of laundry with Bharat Laundary.
                                </p>
                                <div class="d-flex flex-wrap">
                                    <a href="#" data-toggle="modal" data-target="#schedulePickupModal" class="btn btn-primary btn-lg rounded-pill px-5 py-3 mr-3 mb-3 shadow d-flex align-items-center">
                                        <i class="fa fa-calendar-check-o mr-2"></i> Schedule Pickup
                                    </a>
                                    <a href="/pricing" class="btn btn-outline-primary btn-lg rounded-pill px-5 py-3 mb-3 d-flex align-items-center">
                                        <i class="fa fa-tag mr-2"></i> Check Pricing
                                    </a>
                                </div>
                                <div class="mt-4 text-muted small">
                                    <i class="fa fa-star text-warning"></i> 4.8/5 Rating based on 10,000+ orders
                                </div>
                            </div>
                            <div class="col-lg-6 order-1 order-lg-2 text-center mb-5 mb-lg-0">
                                <div class="position-relative">
                                    <div class="rounded-circle bg-primary opacity-10 position-absolute" style="width: 400px; height: 400px; top: -50px; right: -50px; opacity: 0.1; z-index: 0;"></div>
                                    <img src="/bharatlaundary/static/src/img/laundry_hero_bg.png" class="img-fluid rounded-lg shadow-lg position-relative" alt="Happy Family Laundry" style="z-index: 1; max-height: 500px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Process Section (Icons) -->
                <section class="py-5 bg-light">
                    <div class="container">
                        <div class="row text-center justify-content-center">
                            <div class="col-md-3 mb-4">
                                <div class="bg-white p-4 rounded shadow-sm h-100 feature-box">
                                    <i class="fa fa-mobile fa-3x text-primary mb-3"></i>
                                    <h5>1. Book Order</h5>
                                    <p class="text-muted small">Schedule a pickup via website or WhatsApp.</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-4">
                                <div class="bg-white p-4 rounded shadow-sm h-100 feature-box">
                                    <i class="fa fa-truck fa-3x text-primary mb-3"></i>
                                    <h5>2. We Pickup</h5>
                                    <p class="text-muted small">Our rider collects your clothes from your doorstep.</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-4">
                                <div class="bg-white p-4 rounded shadow-sm h-100 feature-box">
                                    <i class="fa fa-superpowers fa-3x text-primary mb-3"></i>
                                    <h5>3. We Clean</h5>
                                    <p class="text-muted small">Expert cleaning with premium eco-friendly detergents.</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-4">
                                <div class="bg-white p-4 rounded shadow-sm h-100 feature-box">
                                    <i class="fa fa-smile-o fa-3x text-primary mb-3"></i>
                                    <h5>4. Delivery</h5>
                                    <p class="text-muted small">Fresh, clean clothes delivered back to you.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Services Section -->
                <section class="section-services py-5 bg-white">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h2 class="font-weight-bold" style="color: #2c3e50;">Our Services</h2>
                            <div class="h-1 bg-primary mx-auto mt-3" style="width: 60px; height: 4px; border-radius: 2px;"></div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-4">
                                <div class="service-card p-4 text-center border h-100 hover-shadow">
                                    <div class="icon-box mb-3 text-primary">
                                        <i class="fa fa-tint fa-4x"></i>
                                    </div>
                                    <h4>Wash &amp; Fold</h4>
                                    <p class="text-muted">Perfect for daily wear. Clothes are washed, dried, and neatly folded.</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="service-card p-4 text-center border h-100 hover-shadow bg-primary text-white scale-up">
                                    <div class="icon-box mb-3 text-white">
                                        <i class="fa fa-shirtsinbulk fa-4x"></i>
                                    </div>
                                    <h4 class="text-white">Wash &amp; Iron</h4>
                                    <p class="opacity-75">Crisp, steam-ironed clothes ready to wear. Most popular choice.</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="service-card p-4 text-center border h-100 hover-shadow">
                                    <div class="icon-box mb-3 text-primary">
                                        <i class="fa fa-black-tie fa-4x"></i>
                                    </div>
                                    <h4>Dry Cleaning</h4>
                                    <p class="text-muted">Special care for your delicate and expensive garments.</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="service-card p-4 text-center border h-100 hover-shadow">
                                    <div class="icon-box mb-3 text-primary">
                                        <i class="fa fa-hospital-o fa-4x"></i>
                                    </div>
                                    <h4>Shoe Cleaning</h4>
                                    <p class="text-muted">Restore your shoes to their original glory with logic spa.</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="service-card p-4 text-center border h-100 hover-shadow">
                                    <div class="icon-box mb-3 text-primary">
                                        <i class="fa fa-bed fa-4x"></i>
                                    </div>
                                    <h4>Carpet Cleaning</h4>
                                    <p class="text-muted">Deep cleaning to remove dust, stains and allergens.</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="service-card p-4 text-center border h-100 hover-shadow">
                                    <div class="icon-box mb-3 text-primary">
                                        <i class="fa fa-bolt fa-4x"></i>
                                    </div>
                                    <h4>Express Service</h4>
                                    <p class="text-muted">Need it fast? Get your clothes back in 24 hours.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Why Choose Us -->
                <section class="py-5 bg-light border-top">
                    <div class="container">
                       <div class="row align-items-center">
                           <div class="col-lg-6">
                               <h2 class="mb-4 font-weight-bold">Why Choose Bharat Laundary?</h2>
                               <ul class="list-unstyled">
                                   <li class="mb-3 d-flex align-items-start">
                                       <i class="fa fa-check-circle text-success mt-1 mr-3 fa-lg"></i>
                                       <div>
                                           <h5 class="mb-1">Hygienic Processing</h5>
                                           <p class="text-muted mb-0">We use separate machines for each customer.</p>
                                       </div>
                                   </li>
                                   <li class="mb-3 d-flex align-items-start">
                                       <i class="fa fa-check-circle text-success mt-1 mr-3 fa-lg"></i>
                                       <div>
                                           <h5 class="mb-1">Eco-Friendly Solvents</h5>
                                           <p class="text-muted mb-0">Safe for your clothes and the environment.</p>
                                       </div>
                                   </li>
                                   <li class="mb-3 d-flex align-items-start">
                                       <i class="fa fa-check-circle text-success mt-1 mr-3 fa-lg"></i>
                                       <div>
                                           <h5 class="mb-1">Free Pickup &amp; Delivery</h5>
                                           <p class="text-muted mb-0">Convenience at no extra cost.</p>
                                       </div>
                                   </li>
                               </ul>
                               <a href="/shop" class="btn btn-primary rounded-pill px-4 mt-3">Book Now</a>
                           </div>
                           <div class="col-lg-6 text-center">
                               <img src="/bharatlaundary/static/src/img/services-clothes.jpg" class="img-fluid rounded shadow" alt="Quality Service"/>
                           </div>
                       </div>
                    </div>
                </section>

                <!-- Floating WhatsApp Button -->
                <a href="https://wa.me/917988543386" class="position-fixed" style="bottom: 30px; right: 30px; z-index: 1000;">
                    <div class="rounded-circle bg-success shadow-lg d-flex align-items-center justify-content-center p-3" style="width: 60px; height: 60px; background-color: #25d366 !important;">
                        <i class="fa fa-whatsapp fa-2x text-white"></i>
                    </div>
                </a>

                <!-- Schedule Pickup Modal -->
                <div class="modal fade" id="schedulePickupModal" tabindex="-1" role="dialog" aria-labelledby="schedulePickupModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content border-0 shadow-lg">
                            <div class="modal-header bg-primary text-white border-0">
                                <h5 class="modal-title font-weight-bold" id="schedulePickupModalLabel">Schedule Your Pickup</h5>
                                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="opacity: 1;">
                                    <span aria-hidden="true">&#215;</span>
                                </button>
                            </div>
                            <form action="/bharatlaundary/schedule/submit" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="modal-body p-4">
                                    <div class="form-group">
                                        <label for="name" class="font-weight-bold text-muted small text-uppercase">Your Name</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0 bg-light"><i class="fa fa-user text-primary"></i></span>
                                            </div>
                                            <input type="text" class="form-control border-0 bg-light" id="name" name="name" required="required" placeholder="John Doe"/>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="mobile" class="font-weight-bold text-muted small text-uppercase">Mobile Number <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0 bg-light"><i class="fa fa-phone text-primary"></i></span>
                                            </div>
                                            <input type="tel" class="form-control border-0 bg-light" id="mobile" name="mobile" required="required" placeholder="10-digit mobile number"/>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="address" class="font-weight-bold text-muted small text-uppercase">Pickup Address</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0 bg-light"><i class="fa fa-map-marker text-primary"></i></span>
                                            </div>
                                            <textarea class="form-control border-0 bg-light" id="address" name="address" rows="3" placeholder="Full address including flat/house no."></textarea>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="pickup_datetime" class="font-weight-bold text-muted small text-uppercase">Preferred Pickup Time</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0 bg-light"><i class="fa fa-clock-o text-primary"></i></span>
                                            </div>
                                            <input type="datetime-local" class="form-control border-0 bg-light" id="pickup_datetime" name="pickup_datetime"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-0 p-4">
                                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">Confirm Pickup</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <style>
                    .hover-shadow:hover { box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; transform: translateY(-5px); transition: all 0.3s; }
                    .scale-up { transform: scale(1.05); z-index: 1; border: none; box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important; }
                    .opacity-75 { opacity: 0.75; }
                    /* Form Styles */
                    .form-control:focus { box-shadow: none; background-color: #fff !important; border: 1px solid var(--primary-color) !important; }
                    .input-group-text { min-width: 45px; justify-content: center; }
                </style>
            </div>
        </xpath>
    </template>


    <template id="rate_list_page" name="Bharat Laundary Rate List">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Premium Hero Section -->
                <section class="s_cover pt96 pb96 text-white" style="background-image: linear-gradient(rgba(0,173,239,0.9), rgba(0,173,239,0.7)), url('/bharatlaundary/static/src/img/pricing_hero.png'); background-size: cover; background-position: center; border-bottom: 5px solid var(--secondary-color);">
                    <div class="container text-center">
                        <span class="badge badge-pill bg-warning text-dark px-3 py-2 mb-3 shadow-sm animate__animated animate__fadeInDown" style="text-transform: uppercase; font-size: 0.8rem; letter-spacing: 2px;">Transparency Guaranteed</span>
                        <h1 class="display-3 font-weight-bold mb-3">Simple, Usage-Based Pricing</h1>
                        <p class="lead mb-4 opacity-75 text-white">No hidden fees. Pay only for what you wash.</p>
                        <div class="d-inline-flex align-items-center bg-white rounded-pill p-1 shadow-lg">
                            <span class="px-4 py-2 font-weight-bold text-primary">Need a Quote? +91 79885 43386</span>
                        </div>
                    </div>
                </section>
                
                <!-- Category Grid -->
                <section class="bg-white pt64 pb96">
                    <div class="container-fluid px-lg-5">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 justify-content-center">
                            <t t-foreach="categories" t-as="category">
                                <div class="col mb-4">
                                    <div class="card border-0 shadow-sm h-100 compact-card transition-all">
                                        <!-- Header -->
                                        <div class="card-header text-white py-3 px-4 border-0 d-flex justify-content-between align-items-center bg-primary" style="border-radius: 12px 12px 0 0;">
                                            <h5 class="m-0 font-weight-bold text-uppercase" style="letter-spacing: 1px;"><t t-esc="category.name"/></h5>
                                            <i class="fa fa-snowflake-o opacity-50"></i>
                                        </div>
                                        
                                        <!-- ListBody -->
                                        <div class="card-body p-0">
                                            <t t-if="category.product_tmpl_ids">
                                                <ul class="list-group list-group-flush">
                                                    <li t-foreach="category.product_tmpl_ids" t-as="product" class="list-group-item d-flex justify-content-between align-items-center py-2 px-4 hover-bg-light border-bottom-soft">
                                                        <div class="flex-grow-1">
                                                            <div class="font-weight-600 text-dark" style="font-size: 0.95rem;"><t t-esc="product.name"/></div>
                                                            <t t-if="product.uom_id">
                                                                <small class="text-primary text-uppercase font-weight-bold" style="font-size: 0.65rem; opacity: 0.8;">
                                                                    PER <t t-esc="product.uom_id.name"/>
                                                                </small>
                                                            </t>
                                                        </div>
                                                        <div class="text-right">
                                                            <span class="font-weight-bold text-primary" style="font-size: 1.1rem;">
                                                                ₹<t t-esc="int(product.list_price)"/>
                                                            </span>
                                                        </div>
                                                    </li>
                                                </ul>
                                            </t>
                                            <t t-else="">
                                                <div class="p-4 text-center text-muted italic small">Category details updating soon...</div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
                
                <!-- Trust Footer -->
                <section class="py-4 bg-light border-top border-bottom">
                    <div class="container">
                        <div class="row text-center">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <i class="fa fa-truck fa-2x mb-2 text-primary"></i>
                                <h6 class="font-weight-bold m-0 text-uppercase small">Free Pickup &amp; Drop</h6>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <i class="fa fa-shield fa-2x mb-2 text-primary"></i>
                                <h6 class="font-weight-bold m-0 text-uppercase small">Hygienic Process</h6>
                            </div>
                            <div class="col-md-4">
                                <i class="fa fa-clock-o fa-2x mb-2 text-primary"></i>
                                <h6 class="font-weight-bold m-0 text-uppercase small">24h Express Available</h6>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- Custom Styles -->
                <style>
                    .pt120 { padding-top: 120px !important; }
                    .pb120 { padding-bottom: 120px !important; }
                    .font-weight-600 { font-weight: 600; }
                    .compact-card { border-radius: 12px !important; overflow: hidden; background: #fff; }
                    .border-bottom-soft { border-bottom: 1px solid rgba(0,0,0,0.03) !important; }
                    .hover-bg-light:hover { background-color: #f8fbff; }
                    .compact-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
                    .transition-all { transition: all 0.2s ease-in-out; }
                    .display-3 { font-size: 3.5rem; letter-spacing: -1px; }
                    @media (max-width: 768px) {
                        .display-3 { font-size: 2.5rem; }
                        .container-fluid { px: 1rem !important; }
                    }
                </style>
            </div>
        </t>
    </template>

