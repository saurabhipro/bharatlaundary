<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_laundry" model="ir.ui.view">
        <field name="name">hr.employee.form.laundry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="laundry_role" string="Laundry Specialized Role"/>
            </xpath>
        </field>
    </record>

    <!-- Also update the employee list view -->
    <record id="view_employee_tree_inherit_laundry" model="ir.ui.view">
        <field name="name">hr.employee.list.laundry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="job_id" position="after">
                <field name="laundry_role" widget="badge"/>
            </field>
        </field>
    </record>
    <!-- Update the employee Kanban view -->
    <record id="hr_kanban_view_employees_inherit_laundry" model="ir.ui.view">
        <field name="name">hr.employee.kanban.laundry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="laundry_role"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_kanban_details')]//ul" position="inside">
                <li t-if="record.laundry_role.raw_value" class="mt-1">
                    <span class="badge rounded-pill text-bg-info">
                        <i class="fa fa-tag me-1"/>
                        <field name="laundry_role"/>
                    </span>
                </li>
            </xpath>
        </field>
    </record>
</odoo>
